{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/cue",
  "version": "2.1.4",
  "description": "cue-config: generate package.json, tsconfig.json and .gitignore for TypeScript projects from composable feature presets (ts, node, react, vite, vitest), validated by CUE schemas. Includes shared tsconfig presets.",
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./ts/config/base.json": "./ts/config/base.json",
    "./ts/config/esm.json": "./ts/config/esm.json",
    "./ts/config/cjs.json": "./ts/config/cjs.json",
    "./ts/config/lib.json": "./ts/config/lib.json",
    "./ts/config/ts.json": "./ts/config/ts.json",
    "./ts/config/node.json": "./ts/config/node.json",
    "./ts/config/node-cjs.json": "./ts/config/node-cjs.json",
    "./ts/config/vite.json": "./ts/config/vite.json",
    "./ts/config/react.json": "./ts/config/react.json",
    "./ts/config/test.json": "./ts/config/test.json",
    "./dependencies/*": "./dependencies/*",
    "./features.json": "./features.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "ts",
    "npm",
    "git",
    "dependencies",
    "features",
    "features.json",
    "client",
    "docker",
    "ecosystem",
    "project",
    "splay",
    "cue.mod/module.cue",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "bin": {
    "cue-config": "dist/cli.js"
  },
  "keywords": [
    "cue",
    "cuelang",
    "typescript",
    "tsconfig",
    "package-json",
    "gitignore",
    "config",
    "configuration",
    "generator",
    "scaffolding",
    "presets",
    "monorepo",
    "schema",
    "validation",
    "vite",
    "vitest",
    "react",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/cue.git"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/cue/issues"
  },
  "homepage": "https://github.com/mark1russell7/cue#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@mark1russell7/api-report": "^0.5.0",
    "@mark1russell7/conventions": "^0.41.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && pnpm --filter @cue/site run typecheck",
    "clean": "rm -rf dist .tsbuildinfo",
    "generate:self": "node dist/cli.js self-generate",
    "test": "node --test \"test/*.test.ts\" && pnpm --filter @cue/site run test",
    "prepare": "npm run build",
    "check:conventions": "conventions check",
    "check:api": "api-report check"
  },
  "conventions": {
    "rules": {
      "typed-scripts": {
        "ignore": [
          "dist/**"
        ],
        "reason": "dist/ is the build output of src/, which is TypeScript. Git keeps dist/, because other repositories install this package from git."
      },
      "no-build-output": {
        "ignore": [
          "dist/**"
        ],
        "reason": "dist/ is the build output of src/. Git keeps dist/, because other repositories install this package from git."
      }
    }
  }
}
